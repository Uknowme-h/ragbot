# Copy this file to .env and fill in your Groq API key.
# Get a free key at https://console.groq.com

GROQ_API_KEY=

# Generation model (free developer tier)
GROQ_LLM_MODEL=openai/gpt-oss-20b

# Prompt-injection classifier (free developer tier)
GROQ_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m

# Retrieval
CHROMA_PATH=./chroma_store
COLLECTION_NAME=knowledge_base
SIMILARITY_THRESHOLD=0.35
TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=150
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBED_BATCH_SIZE=32

# Groq HTTP timeout in seconds
GROQ_TIMEOUT_SECONDS=30
